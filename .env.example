# این فایل را کپی کنید به .env . فایل .env هرگز در Git قرار نمی‌گیرد.
BALE_BOT_TOKEN=
BALE_API_BASE=https://tapi.bale.ai
BALE_BOT_USERNAME=
DARUYAR_DB=daruyar.db
# پیش‌فرض امن: فقط همین دستگاه. برای اتصال گوشی در شبکه‌ی مورد اعتماد 0.0.0.0 بگذارید (HTTP رمزنگاری نمی‌شود)
DARUYAR_HOST=127.0.0.1
DARUYAR_PORT=8765
# اگر پر شود، /api/bale_webhook فقط با هدر X-Webhook-Secret (یا ?secret=) یکسان پذیرفته می‌شود (برای n8n)
WEBHOOK_SECRET=
# اگر WEBHOOK_SECRET خالی باشد، وب‌هوک رد می‌شود. فقط برای آزمایش محلی: DARUYAR_ALLOW_OPEN_WEBHOOK=1
DARUYAR_ALLOW_OPEN_WEBHOOK=
# مبدأهای مجاز CORS (جداشده با ویرگول). مبدأ WebView اپ (null) همیشه مجاز است
DARUYAR_CORS_ORIGINS=
# فقط وقتی سرور واقعاً پشت HTTPS است: HSTS را روشن می‌کند
DARUYAR_BEHIND_HTTPS=
# فقط پشت reverse proxy مورد اعتماد: IP کلاینت از X-Forwarded-For خوانده شود (برای محدودیت تلاش ورود)
DARUYAR_TRUST_PROXY=
